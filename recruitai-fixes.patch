+# Copy this file to `.env` (the server loads .env, not .env.local) and fill in the values.
+
+# ── REQUIRED ────────────────────────────────────────────────────────────────
+# Supabase project (Dashboard → Project Settings → API).
+# Use the service_role key: it is only ever used on the server, never sent to the browser.
+SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
+SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
+
+# ── OPTIONAL ────────────────────────────────────────────────────────────────
+# OpenRouter key for AI resume parsing and candidate scoring.
+# Without it the app falls back to a simple heuristic scorer.
+OPENROUTER_API_KEY=""
+
+# Brevo key for sending real emails. Without it, emails are only logged to the console.
+BREVO_API_KEY=""
+BREVO_SENDER_EMAIL="noreply@recruit-ai.com"
+
+# Public URL of your deployment (used for the OpenRouter referer and the keep-alive ping).
+PUBLIC_URL="http://localhost:3000"
+
+# Port to listen on (default 3000).
+PORT=3000
